{
  "expo": {
    "name": "elder",
    "slug": "elder",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "elder",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "package": "com.elder.app",
      "adaptiveIcon": {
        "backgroundColor": "#11375C",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FDF9F6",
          "image": "./assets/images/brand/Simbolo - azul.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Elder usa suas fotos para anexar exames e receitas ao seu perfil."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Elder usa sua localização para mostrar no mapa os serviços perto de você."
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.PLACEHOLDER"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0e94b62e-806b-41af-afe2-a7faca5194b4"
      }
    }
  }
}
