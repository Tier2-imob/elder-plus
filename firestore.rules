rules_version = '2';

// Elder+ — regras de segurança do Firestore.
// Publicar pelo console (Firestore → Regras) ou `firebase deploy --only firestore:rules`.
// Antes de publicar: comparar com as regras atuais do console e testar no Emulator.
//
// Círculo de cuidado (ver .agents/tasks/family-circle-plan.md):
//   circles/{circleId}                 dados do círculo (titular nominal ou com conta)
//   circles/{circleId}/members/{uid}   papel, permissões, status pendente|ativo
//   invites/{code}                     convite de uso único, validade de 7 dias
//   persons/{personId}                 pessoa assistida (usuário gerenciado; `uid` quando tem conta)
//   circles/{id}.status                'ativo' (padrão) | 'inativo': inativo = somente leitura, os dados
//                                      continuam no banco; só quem gerencia inativa e reativa
//   users/{uid}.circleIds              círculos do usuário (até 5); contas antigas: `circleId`
//   users/{uid}.roles                  perfis do usuário (elder, family, partner); antigas: `role`
// As escritas com várias partes (criar círculo, aceitar convite, sair) são batches; as regras
// conferem os documentos entre si com getAfter/existsAfter.

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ────────────────────────────────────────────────────────────────

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function circlePath(circleId) {
      return /databases/$(database)/documents/circles/$(circleId);
    }

    function memberPath(circleId, uid) {
      return /databases/$(database)/documents/circles/$(circleId)/members/$(uid);
    }

    function invitePath(code) {
      return /databases/$(database)/documents/invites/$(code);
    }

    function personPath(personId) {
      return /databases/$(database)/documents/persons/$(personId);
    }

    // Perfis de um users/{uid}: `roles` (lista); contas anteriores só têm `role`.
    function rolesOf(data) {
      return data.get('roles', [data.get('role', 'family')]);
    }

    function myRoles() {
      return rolesOf(get(userPath(request.auth.uid)).data);
    }

    // Círculos de um users/{uid}: `circleIds` (lista); contas anteriores só têm `circleId`.
    function circleIdsOf(data) {
      return data.get('circleIds', [data.get('circleId', null)].removeAll([null]));
    }

    function myCircleIds() {
      return circleIdsOf(get(userPath(request.auth.uid)).data);
    }

    // Teto de segurança de ids de círculo por conta. O limite do produto (5 círculos ATIVOS) é conferido
    // no app: círculos inativos não contam, e as regras não conseguem saber o status de cada um.
    function maxCircles() {
      return 20;
    }

    // Círculo inativo é somente leitura: nada é gravado nele até ser reativado (ou excluído).
    function isCircleActive(circleId) {
      return get(circlePath(circleId)).data.get('status', 'ativo') == 'ativo';
    }

    // Dados da pessoa assistida (todos opcionais): nome, data de nascimento "AAAA-MM-DD" e telefone só
    // com dígitos (DDD + 8 ou 9 dígitos). O app valida o calendário; as regras conferem o formato.
    function validPersonData(data) {
      return data.name is string && data.name.trim().size() >= 2 && data.name.size() <= 120
        && (data.get('birthDate', null) == null
            || (data.birthDate is string && data.birthDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && (data.get('phone', null) == null
            || (data.phone is string && data.phone.matches('^[0-9]{10,11}$')));
    }

    // Quem pode excluir o círculo de vez: o titular com conta ou, com titular nominal, quem gerencia.
    function canDeleteCircle(circleId) {
      let circle = get(circlePath(circleId)).data;
      return circle.subject.uid == request.auth.uid
        || (circle.subject.uid == null && can(circleId, 'gerenciar-membros'));
    }

    // Criar ou aceitar convite: perfil de cuidado (idoso ou família), ainda não está nesse
    // círculo e não passou do limite. Parceiros não participam de círculos.
    function canJoinAnotherCircle(circleId) {
      return myRoles().hasAny(['elder', 'family'])
        && !(circleId in myCircleIds())
        && myCircleIds().size() < maxCircles();
    }

    function myMember(circleId) {
      return get(memberPath(circleId, request.auth.uid)).data;
    }

    function isActiveMember(circleId) {
      return signedIn()
        && exists(memberPath(circleId, request.auth.uid))
        && myMember(circleId).status == 'ativo';
    }

    function can(circleId, permission) {
      return isActiveMember(circleId) && permission in myMember(circleId).permissions;
    }

    // Ninguém concede permissão que não tem.
    function withinMyPermissions(circleId, permissions) {
      return permissions.toSet().difference(myMember(circleId).permissions.toSet()).size() == 0;
    }

    function allPermissions() {
      return ['ver-rotina', 'editar-rotina', 'ver-saude', 'editar-saude', 'emergencia', 'gerenciar-membros'];
    }

    // Circle creator: every permission, `emergencia` optional (granted later, once there is a phone;
    // circles created by older app versions included it).
    function hasCreatorPermissions(permissions) {
      return permissions.toSet().hasAll(['ver-rotina', 'editar-rotina', 'ver-saude', 'editar-saude', 'gerenciar-membros'])
        && permissions.toSet().difference(allPermissions().toSet()).size() == 0;
    }

    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ─── Perfil ─────────────────────────────────────────────────────────────────

    match /users/{uid} {
      allow read: if isSelf(uid);

      // Cadastro exige aceite dos termos carimbado pelo servidor (LGPD); nasce sem círculos e com
      // perfis válidos.
      allow create: if isSelf(uid)
        && request.resource.data.termsVersion is string
        && request.resource.data.termsAcceptedAt == request.time
        && request.resource.data.get('circleId', null) == null
        && request.resource.data.get('circleIds', []).size() == 0
        && rolesOf(request.resource.data).size() >= 1
        && rolesOf(request.resource.data).toSet().difference(['elder', 'family', 'partner'].toSet()).size() == 0;

      allow update: if isSelf(uid)
        && changed().hasOnly(['circleId', 'circleIds', 'name', 'roles'])
        && circleIdsUpdateOk(uid)
        && rolesUpdateOk();

      // Círculos: sair só remove ids (inclusive ponteiro órfão); entrar acrescenta exatamente um id,
      // no fim da lista, onde o próprio membro existe ao fim do batch — e respeita o limite.
      function circleIdsUpdateOk(uid) {
        let before = circleIdsOf(resource.data);
        let after = circleIdsOf(request.resource.data);
        return before.toSet().hasAll(after.toSet())
          || (
            after.size() == before.size() + 1
            && after.size() <= maxCircles()
            && after.toSet().hasAll(before.toSet())
            && existsAfter(memberPath(after[after.size() - 1], uid))
          );
      }

      // Perfis: pode acrescentar idoso ou família (parceiro só no cadastro); nunca fica sem nenhum.
      function rolesUpdateOk() {
        let before = rolesOf(resource.data);
        let after = rolesOf(request.resource.data);
        return after.size() >= 1
          && after.toSet().difference(before.toSet().union(['elder', 'family'].toSet())).size() == 0;
      }

      // Dados legados por usuário (favoritos, tarefas e medicamentos antes da migração).
      // `{collection}/` antes do curinga: `{document=**}` sozinho casa zero segmentos e valeria
      // também para o próprio users/{uid}, anulando as restrições do perfil acima.
      match /{collection}/{document=**} {
        allow read, write: if isSelf(uid);
      }
    }

    // ─── Avaliações ─────────────────────────────────────────────────────────────

    match /businesses/{businessId}/reviews/{reviewId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.authorUid == request.auth.uid;
    }

    // ─── Círculo ────────────────────────────────────────────────────────────────

    match /circles/{circleId} {
      // Pendente também lê o círculo (tela "aguardando aprovação").
      allow read: if signedIn() && exists(memberPath(circleId, request.auth.uid));

      allow create: if signedIn()
        && canJoinAnotherCircle(circleId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.memberCount == 1
        && request.resource.data.emergencyCount == 0
        && request.resource.data.get('status', 'ativo') == 'ativo'
        && request.resource.data.consent.by == request.auth.uid
        && request.resource.data.consent.at == request.time
        && request.resource.data.consent.version is string
        && request.resource.data.subject.name is string
        && request.resource.data.subject.name.size() > 0
        // Conta elder é o próprio titular; as demais criam com titular nominal.
        && (
          request.resource.data.subject.uid == null
          || (request.resource.data.subject.uid == request.auth.uid && 'elder' in myRoles())
        )
        // A pessoa assistida nasce junto, como persons/{subjectId} (apps antigos não a criam).
        && (
          request.resource.data.get('subjectId', null) == null
          || existsAfter(personPath(request.resource.data.subjectId))
        )
        && existsAfter(memberPath(circleId, request.auth.uid));

      allow update: if signedIn() && (
        // Quem gerencia: nome do titular, contadores e vínculo do titular com conta.
        (
          can(circleId, 'gerenciar-membros')
          && resource.data.get('status', 'ativo') == 'ativo'
          && changed().hasOnly(['subject', 'memberCount', 'emergencyCount'])
          && request.resource.data.memberCount >= 0
          && request.resource.data.memberCount <= 10
          && request.resource.data.emergencyCount >= 0
          && request.resource.data.emergencyCount <= 3
          && (
            request.resource.data.subject.uid == resource.data.subject.uid
            || (
              resource.data.subject.uid == null
              && getAfter(memberPath(circleId, request.resource.data.subject.uid)).data.role == 'titular'
              && getAfter(memberPath(circleId, request.resource.data.subject.uid)).data.status == 'ativo'
            )
          )
          // O nome da pessoa assistida é um só: mudar o do círculo exige mudar o da pessoa junto.
          && (
            request.resource.data.subject.name == resource.data.subject.name
            || resource.data.get('subjectId', null) == null
            || getAfter(personPath(resource.data.subjectId)).data.name == request.resource.data.subject.name
          )
        )
        // Inativar / reativar: só quem gerencia. Inativar carimba quando e por quem; reativar limpa.
        || (
          can(circleId, 'gerenciar-membros')
          && changed().hasOnly(['status', 'inactivatedAt', 'inactivatedBy'])
          && (
            (
              resource.data.get('status', 'ativo') == 'ativo'
              && request.resource.data.status == 'inativo'
              && request.resource.data.inactivatedAt == request.time
              && request.resource.data.inactivatedBy == request.auth.uid
            )
            || (
              resource.data.get('status', 'ativo') == 'inativo'
              && request.resource.data.status == 'ativo'
              && !('inactivatedAt' in request.resource.data)
              && !('inactivatedBy' in request.resource.data)
            )
          )
        )
        // Quem aceita convite: +1 membro, respeitando o limite (só em círculo ativo).
        || (
          resource.data.get('status', 'ativo') == 'ativo'
          && changed().hasOnly(['memberCount'])
          && request.resource.data.memberCount == resource.data.memberCount + 1
          && request.resource.data.memberCount <= 10
          && !exists(memberPath(circleId, request.auth.uid))
          && existsAfter(memberPath(circleId, request.auth.uid))
        )
        // Quem sai: -1 membro (e -1 emergência, se era contato).
        || (
          changed().hasOnly(['memberCount', 'emergencyCount'])
          && request.resource.data.memberCount == resource.data.memberCount - 1
          && request.resource.data.emergencyCount >= resource.data.emergencyCount - 1
          && request.resource.data.emergencyCount <= resource.data.emergencyCount
          && exists(memberPath(circleId, request.auth.uid))
          && !existsAfter(memberPath(circleId, request.auth.uid))
        )
      );

      // Titular com conta; com titular nominal, quem gerencia.
      allow delete: if signedIn() && (
        resource.data.subject.uid == request.auth.uid
        || (resource.data.subject.uid == null && can(circleId, 'gerenciar-membros'))
      );

      match /members/{memberUid} {
        allow read: if isActiveMember(circleId) || isSelf(memberUid);

        allow create: if isSelf(memberUid) && (
          // Criador, no mesmo batch do círculo: titular (conta elder) ou admin, com tudo.
          (
            !exists(circlePath(circleId))
            && getAfter(circlePath(circleId)).data.createdBy == memberUid
            && request.resource.data.status == 'ativo'
            && hasCreatorPermissions(request.resource.data.permissions)
            && (
              (request.resource.data.role == 'titular'
                && getAfter(circlePath(circleId)).data.subject.uid == memberUid)
              || (request.resource.data.role == 'admin'
                && getAfter(circlePath(circleId)).data.subject.uid == null)
            )
          )
          // Convidado: entra pendente, com exatamente o que o convite concede.
          || (
            exists(circlePath(circleId))
            && isCircleActive(circleId)
            && canJoinAnotherCircle(circleId)
            && request.resource.data.status == 'pendente'
            && get(invitePath(request.resource.data.inviteCode)).data.circleId == circleId
            && get(invitePath(request.resource.data.inviteCode)).data.usedBy == null
            && get(invitePath(request.resource.data.inviteCode)).data.revoked == false
            && get(invitePath(request.resource.data.inviteCode)).data.expiresAt > request.time
            && getAfter(invitePath(request.resource.data.inviteCode)).data.usedBy == memberUid
            && request.resource.data.role == get(invitePath(request.resource.data.inviteCode)).data.role
            && request.resource.data.permissions == get(invitePath(request.resource.data.inviteCode)).data.permissions
            && request.resource.data.label == get(invitePath(request.resource.data.inviteCode)).data.label
            && request.resource.data.invitedBy == get(invitePath(request.resource.data.inviteCode)).data.createdBy
          )
        );

        allow update: if signedIn() && (
          // Quem gerencia, nunca no próprio doc, e só com o círculo ativo.
          (
            can(circleId, 'gerenciar-membros')
            && isCircleActive(circleId)
            && memberUid != request.auth.uid
            && (
              // Titular: só pode ser aprovado (pendente → ativo); depois é intocável.
              (
                resource.data.role == 'titular'
                && resource.data.status == 'pendente'
                && changed().hasOnly(['status'])
                && request.resource.data.status == 'ativo'
              )
              || (
                resource.data.role != 'titular'
                && request.resource.data.role != 'titular'
                && changed().hasOnly(['role', 'label', 'permissions', 'status'])
                && withinMyPermissions(circleId, request.resource.data.permissions)
                && (
                  request.resource.data.status == resource.data.status
                  || (resource.data.status == 'pendente' && request.resource.data.status == 'ativo')
                )
              )
            )
          )
          // O próprio membro: último acesso e telefone.
          || (isSelf(memberUid) && changed().hasOnly(['lastAccess', 'phone']))
        );

        allow delete: if signedIn() && (
          // Remover/recusar: quem gerencia, nunca a si mesmo nem o titular ativo. Com o círculo inativo,
          // só junto com a exclusão do círculo.
          (
            can(circleId, 'gerenciar-membros')
            && (isCircleActive(circleId) || !existsAfter(circlePath(circleId)))
            && memberUid != request.auth.uid
            && !(resource.data.role == 'titular' && resource.data.status == 'ativo')
          )
          // Sair: qualquer membro, exceto o titular.
          || (isSelf(memberUid) && resource.data.role != 'titular')
        );
      }

      // ─── Dados do círculo (migração na etapa 3) ──────────────────────────────

      match /tasks/{taskId} {
        allow read: if can(circleId, 'ver-rotina');
        // Inativo = somente leitura; apagar só na exclusão definitiva do círculo.
        allow create, update: if can(circleId, 'editar-rotina') && isCircleActive(circleId);
        allow delete: if (can(circleId, 'editar-rotina') && isCircleActive(circleId))
          || (canDeleteCircle(circleId) && !isCircleActive(circleId));
      }

      match /medications/{medicationId} {
        allow read: if can(circleId, 'ver-saude');
        // Inativo = somente leitura; apagar só na exclusão definitiva do círculo.
        allow create, update: if can(circleId, 'editar-saude') && isCircleActive(circleId);
        allow delete: if (can(circleId, 'editar-saude') && isCircleActive(circleId))
          || (canDeleteCircle(circleId) && !isCircleActive(circleId));
      }

      match /medicationDoses/{doseId} {
        allow read: if can(circleId, 'ver-saude');
        // Inativo = somente leitura; apagar só na exclusão definitiva do círculo.
        allow create, update: if can(circleId, 'editar-saude') && isCircleActive(circleId);
        allow delete: if (can(circleId, 'editar-saude') && isCircleActive(circleId))
          || (canDeleteCircle(circleId) && !isCircleActive(circleId));
      }

      // Registro de atividade: só acrescenta.
      match /activity/{entryId} {
        allow read: if can(circleId, 'gerenciar-membros');
        allow create: if isActiveMember(circleId)
          && request.resource.data.by == request.auth.uid
          && request.resource.data.at == request.time;
      }
    }

    // ─── Pessoa assistida ──────────────────────────────────────────────────────────

    // Usuário gerenciado: existe sem conta nem senha (`uid` nulo) e é cuidado pelo círculo dele.
    // Quando ganha conta (convite de titular aprovado), `uid` é vinculado uma única vez.
    match /persons/{personId} {
      allow read: if signedIn() && exists(memberPath(resource.data.circleId, request.auth.uid));

      // Criada junto com o círculo, pelo criador, apontando para ele.
      allow create: if signedIn()
        && request.resource.data.circleId is string
        && !exists(circlePath(request.resource.data.circleId))
        && getAfter(circlePath(request.resource.data.circleId)).data.createdBy == request.auth.uid
        && getAfter(circlePath(request.resource.data.circleId)).data.subjectId == personId
        && request.resource.data.name == getAfter(circlePath(request.resource.data.circleId)).data.subject.name
        && request.resource.data.uid == getAfter(circlePath(request.resource.data.circleId)).data.subject.uid
        && validPersonData(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;

      // Quem gerencia o círculo: nome (círculo ativo), vínculo da conta junto com o do círculo e o
      // status, que espelha o do círculo no mesmo batch.
      allow update: if can(resource.data.circleId, 'gerenciar-membros') && (
        (
          isCircleActive(resource.data.circleId)
          && changed().hasOnly(['name', 'uid', 'birthDate', 'phone'])
          && validPersonData(request.resource.data)
          && request.resource.data.name == getAfter(circlePath(resource.data.circleId)).data.subject.name
          && (
            request.resource.data.uid == resource.data.uid
            || (
              resource.data.uid == null
              && getAfter(circlePath(resource.data.circleId)).data.subject.uid == request.resource.data.uid
            )
          )
        )
        || (
          changed().hasOnly(['status', 'inactivatedAt', 'inactivatedBy'])
          && request.resource.data.get('status', 'ativo')
            == getAfter(circlePath(resource.data.circleId)).data.get('status', 'ativo')
        )
      );

      // Só junto com a exclusão do círculo.
      allow delete: if can(resource.data.circleId, 'gerenciar-membros')
        && !existsAfter(circlePath(resource.data.circleId));
    }

    // ─── Convites ───────────────────────────────────────────────────────────────

    match /invites/{code} {
      // Leitura só pelo código exato (get); listar só quem gerencia o círculo do convite.
      allow get: if signedIn();
      allow list: if signedIn() && can(resource.data.circleId, 'gerenciar-membros');

      allow create: if signedIn()
        && code.matches('^ELDER-[A-Z0-9]{4}-[A-Z0-9]{4}$')
        && can(request.resource.data.circleId, 'gerenciar-membros')
        && withinMyPermissions(request.resource.data.circleId, request.resource.data.permissions)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(8, 'd')
        && request.resource.data.usedBy == null
        && request.resource.data.usedAt == null
        && request.resource.data.revoked == false
        && request.resource.data.role in ['titular', 'admin', 'familiar', 'profissional', 'observador']
        && get(circlePath(request.resource.data.circleId)).data.memberCount < 10
        && isCircleActive(request.resource.data.circleId)
        && (
          request.resource.data.role != 'titular'
          || get(circlePath(request.resource.data.circleId)).data.subject.uid == null
        );

      allow update: if signedIn() && (
        // Aceite: consome o convite no mesmo batch que cria o membro pendente.
        (
          changed().hasOnly(['usedBy', 'usedAt'])
          && resource.data.usedBy == null
          && resource.data.revoked == false
          && resource.data.expiresAt > request.time
          && request.resource.data.usedBy == request.auth.uid
          && request.resource.data.usedAt == request.time
          && isCircleActive(resource.data.circleId)
          && existsAfter(memberPath(resource.data.circleId, request.auth.uid))
        )
        // Revogação: quem gerencia, enquanto não usado.
        || (
          can(resource.data.circleId, 'gerenciar-membros')
          && changed().hasOnly(['revoked'])
          && request.resource.data.revoked == true
          && resource.data.usedBy == null
        )
      );

      allow delete: if false;
    }
  }
}
