# Copie para .env (que não é versionado) e preencha. Em builds do EAS, crie as mesmas variáveis
# com `eas env:create` (ou no painel expo.dev → Project → Environment variables).

# Firebase (Console → Configurações do projeto → Seus apps → Web)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Sign-In — Web client ID (OAuth)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Google Maps Embed API (restrinja a chave à "Maps Embed API" no Google Cloud Console)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Desenvolvimento com o Firebase Emulator (só no .env.local, nunca no EAS):
#   EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=192.168.0.10   (IP do computador na rede do celular)
#   EXPO_PUBLIC_FIREBASE_PROJECT_ID=demo-elder
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=
